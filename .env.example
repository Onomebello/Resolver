# GitHub personal access token (or GitHub App installation token) with repo scope.
# Needs permission to read issues, comment, push branches, open PRs, and manage labels.
GITHUB_TOKEN=

# Secret configured on the GitHub webhook used to verify incoming payloads (HMAC SHA-256).
WEBHOOK_SECRET=

# Anthropic API key used to drive the tool-calling resolver agent.
ANTHROPIC_API_KEY=

# Default target repository (used when the webhook payload doesn't specify one, and for
# validating that only whitelisted repos are processed). Format: owner/repo
GITHUB_REPO=owner/repo

# Optional overrides -----------------------------------------------------

# Anthropic model id used for the resolver agent.
ANTHROPIC_MODEL=claude-sonnet-5

# Label that triggers automated resolution.
TRIGGER_LABEL=ai-resolve

# Port the webhook server listens on.
PORT=3000

# Directory (relative to the project root) where target repos are cloned/checked out.
WORKSPACE_DIR=.workspaces

# Shell command used to run the test suite inside the checked-out workspace.
TEST_COMMAND=npm test

# Max number of run_tests failures before the agent gives up on an issue.
MAX_TEST_RETRIES=4

# Max number of agent tool-call turns before aborting as a safety net.
MAX_AGENT_TURNS=30

# ==========================================================================
# Multi-tenant platform (src/platform) -- npm run platform:dev / platform:migrate
# Not used by the single-tenant webhook server (src/index.ts) or the GitHub Actions
# workflow. See README.md for the full GitHub App setup walkthrough.
# ==========================================================================

# Postgres connection string. `docker compose up -d postgres` matches this default.
DATABASE_URL=postgres://resolver:resolver@localhost:5432/resolver

# From your GitHub App's settings page.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Paste the full contents of the App's downloaded .pem private key. If your secret
# manager can't hold real newlines, use \n escapes -- they're unescaped at load time.
GITHUB_APP_PRIVATE_KEY=
# The webhook secret you set on the App (distinct from WEBHOOK_SECRET above, which is
# for the single-tenant server only).
GITHUB_APP_WEBHOOK_SECRET=

# 32-byte AES-256 key, base64-encoded, used to encrypt each user's stored Anthropic API
# key at rest. Generate with: openssl rand -base64 32
# Rotating this makes all previously stored keys undecryptable -- users would need to
# re-enter them.
ENCRYPTION_KEY=

# Signs the platform's session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Public base URL this service is reachable at (used to build the OAuth callback and
# post-login redirect). No trailing slash.
APP_BASE_URL=http://localhost:4000

# Port the platform control-plane listens on.
PLATFORM_PORT=4000

# Docker image tag launched per job (npm run docker:build:runner builds this).
RUNNER_IMAGE=resolver-runner:latest

# Hard timeout for a single job's container, in milliseconds.
RUNNER_TIMEOUT_MS=1500000
